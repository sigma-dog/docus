generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(uuid())
  username        String
  email           String            @unique
  password        String
  avatarUrl       String?
  refreshToken    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  role            Role              @default(VIEWER)
  pages           Page[]
  ownedSpaces     Space[]
  memberships     SpaceMember[]
  ownedOrgs       Organization[]
  orgMemberships  OrgMember[]
  pageHistory     PageHistory[]
}

model Organization {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  description String?
  avatarUrl   String?
  ownerId     String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  owner       User                @relation(fields: [ownerId], references: [id])
  members     OrgMember[]
  spaces      Space[]
  invites     OrganizationInvite[]
}

model OrganizationInvite {
  id             String      @id @default(uuid())
  code           String      @unique @default(cuid())
  organizationId String
  role           OrgRole     @default(MEMBER)
  expiresAt      DateTime?
  usedAt         DateTime?
  createdAt      DateTime    @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrgMember {
  id             String      @id @default(uuid())
  role           OrgRole     @default(MEMBER)
  organizationId String
  userId         String
  createdAt      DateTime    @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Space {
  id             String        @id @default(uuid())
  name           String
  key            String
  description    String?
  avatarUrl      String?
  ownerId        String
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  pages          Page[]
  owner          User          @relation(fields: [ownerId], references: [id])
  members        SpaceMember[]
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@unique([key, organizationId])
}

model SpaceMember {
  id        String   @id @default(uuid())
  role      Role     @default(VIEWER)
  spaceId   String
  userId    String
  createdAt DateTime @default(now())
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
}

model Page {
  id           String                      @id @default(uuid())
  title        String
  icon         String?
  content      String?
  isFolder     Boolean                     @default(false)
  position     Int                         @default(0)
  spaceId      String
  parentId     String?
  authorId     String
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  searchVector Unsupported("tsvector")?
  author       User                        @relation(fields: [authorId], references: [id])
  parent       Page?                       @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Page[]                      @relation("PageTree")
  space        Space                       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  history      PageHistory[]

  @@index([searchVector], type: Gin, map: "page_search_vector_gin_idx")
}

model PageHistory {
  id        String   @id @default(uuid())
  pageId    String
  authorId  String
  title     String
  content   String?
  createdAt DateTime @default(now())
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([pageId, createdAt(sort: Desc)])
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}
